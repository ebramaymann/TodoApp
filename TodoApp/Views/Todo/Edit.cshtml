@model TodoItem

<!DOCTYPE html>
<html>
<head>
    <title>Edit Task</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
</head>
<body class="container mt-5">
    <h2>Edit Task</h2>
    <form action="/Todo/Edit" method="post" class="mt-3">
        <input type="hidden" name="Id" value="@Model.Id" />

        <div class="mb-3">
            <label class="form-label">Title:</label>
            <input type="text" name="Title" value="@Model.Title" class="form-control" />
        </div>

        <div class="mb-3 form-check">
            <input type="hidden" name="IsCompleted" value="false" />
            <input type="checkbox" name="IsCompleted" value="true" class="form-check-input" @(Model.IsCompleted ? "checked" : "") />
            <label class="form-check-label">Completed</label>
        </div>

        <button type="submit" class="btn btn-success">Update</button>
        <a href="/Todo/Index" class="btn btn-secondary">Back</a>
    </form>
</body>
</html>
